# API and worker use the SAME private PostgreSQL and private bucket.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/line_math
PORT=8000
CORS_ORIGINS=http://localhost:3000
# Messaging API channel + LIFF Login channel must use the same LINE provider.
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=
LINE_CHANNEL_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_PROVIDER_ID=
SESSION_TTL_SECONDS=28800
# Railway bucket display name: adaptable-folder. S3_BUCKET must be the actual
# globally unique bucket name from Credentials, NOT assumed to be the display name.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local development only: STORAGE_BACKEND=local, FILE_STORAGE_ROOT=/tmp/line-math-files
MAX_UPLOAD_BYTES=10485760
AI_ENABLED=false
# OpenAI model used for tutoring.
LLM_MODEL=gpt-5.4-mini
LLM_MAX_OUTPUT_TOKENS=4096
# PDF semantic transcription: one OpenAI request per page, even if AI_ENABLED=false.
# If omitted or blank, PDF_READER_MODEL follows LLM_MODEL.
PDF_READER_MODEL=gpt-5.4-mini
PDF_MAX_OUTPUT_TOKENS=16384
PDF_AI_MAX_PAGES=40
# OpenAI API key shared by tutor, PDF reader and optional embeddings.
LLM_API_KEY=
# Opt-in; 768 dimensions match the existing PostgreSQL column.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
MAX_DAILY_AI_REQUESTS=100
JOB_TIMEOUT_SECONDS=90
MAX_JOB_ATTEMPTS=3
